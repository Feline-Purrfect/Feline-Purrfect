{
  "name": "feline-purrfect-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Feline Purrfect API — Express + Supabase, deployed on Render",
  "main": "src/server.js",
  "type": "module",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "start": "node --import ./src/instrument.js src/server.js",
    "dev": "node --env-file=.env --watch --import ./src/instrument.js src/server.js",
    "job:check-missing-logs": "node --import ./src/instrument.js src/jobs/checkMissingLogs.js",
    "job:check-missing-logs:local": "node --env-file=.env --import ./src/instrument.js src/jobs/checkMissingLogs.js",
    "lint:syntax": "find src test -name '*.js' -print0 | xargs -0 -n1 node --check",
    "test": "node --import ./test/setup.js --test test/routes.test.js test/ask.test.js test/legal.test.js test/notifications.test.js"
  },
  "dependencies": {
    "@sentry/node": "^11.8.0",
    "@sentry/profiling-node": "^11.7.0",
    "@supabase/supabase-js": "^2.45.0",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "expo-server-sdk": "^3.14.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "zod": "^3.23.8"
  }
}
