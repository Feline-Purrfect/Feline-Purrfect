{
  "name": "feline-purrfect-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Feline Purrfect API \u2014 Express + Supabase, deployed on Render",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch --env-file=.env src/server.js",
    "seed:diseases": "node --env-file=.env scripts/seed-diseases.js",
    "job:check-missing-logs": "node src/jobs/checkMissingLogs.js",
    "job:check-missing-logs:local": "node --env-file=.env src/jobs/checkMissingLogs.js",
    "lint:syntax": "find src scripts -name '*.js' -print0 | xargs -0 -n1 node --check",
    "test": "node --test test/routes.test.js"
  },
  "dependencies": {
    "@sentry/node": "^9.0.0",
    "@supabase/supabase-js": "^2.45.0",
    "cors": "^2.8.5",
    "expo-server-sdk": "^3.14.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "zod": "^3.23.8"
  }
}
