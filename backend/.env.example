# ---- Server
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Comma-separated list. Leave empty to allow any origin (fine for a native app; set it if you add a web client).
CORS_ORIGINS=

# ---- Supabase (Dashboard → Project Settings → API)
SUPABASE_URL=
# "anon" / publishable key — used only for sign-in / sign-up flows
SUPABASE_ANON_KEY=
# "service_role" / secret key — SERVER ONLY. Never ship this in the mobile app.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PHOTO_BUCKET=cat-photos

# ---- Monitoring (optional but recommended)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ---- Push notifications (optional; only needed for the daily reminder job)
EXPO_ACCESS_TOKEN=

# ---- Ask (AI chat; without a key the Ask tab says it's unavailable)
# Claude API key from platform.claude.com. SERVER ONLY.
ANTHROPIC_API_KEY=
ASK_MODEL=claude-haiku-5-5
# Questions per user per rolling 24 hours (cost control).
ASK_DAILY_LIMIT=10
